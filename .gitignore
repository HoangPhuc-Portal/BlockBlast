# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you prefer to ignore the asset packages cache
# [Ll]ocal[Pp]ackages/

# Autogenerated Visual Studio and MonoDevelop files
ExportedObj/
.vs/
.idea/
*.sln
*.csproj
*.user
*.userprefs
*.pidb
*.booproj
*.suo
*.userosscache
*.unityproj
*.DS_Store

# Unity 3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressable assets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin

# Temporary OpenXR Package files
/[Aa]ssets/profiles/